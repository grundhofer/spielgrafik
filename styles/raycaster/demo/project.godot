; Engine configuration file.
; Von Hand geschrieben: Katalogeintrag raycaster (2,5D-Sektor-Shooter 1993–1996), Godot 4.7.
; Bild 320×200 wie VGA-Modus 13h: oben 320×168 Ego-Ansicht (SubViewport "View"), unten 32 Zeilen
; Statusleiste. Die 3D-Szene schreibt Palettenindizes in den Bildspeicher; shaders/screen.gdshader setzt
; Himmel und Palette erst bei der Ausgabe ein (wie der DAC der VGA-Karte).

config_version=5

[application]

config/name="Raycaster – Hafen von Lornholm"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=320
window/size/viewport_height=200
window/size/window_width_override=960
window/size/window_height_override=600
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false,
"process/fix_alpha_border": false
}

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
anti_aliasing/quality/use_debanding=false
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
