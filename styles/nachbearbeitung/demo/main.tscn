directional_shadow_max_distance = 60.0

; Lage setzt main.gd (look_at aus CAM_POS/CAM_TARGET, ausgerechnet mit scripts/frame_shot.py)
[node name="Camera" type="Camera3D" parent="ScreenVP/WorldVP/World"]
