[gd_scene load_steps=21 format=3]

; Nachbearbeitung & Look-Filter: dieselbe Hafenszene (shared/3d) mit sechs umschaltbaren Looks.
; Aufbau (Reihenfolge = Renderreihenfolge, Kind-Viewports zuerst):
;   ScreenVP (SubViewport 1280×720, 2D)
;     WorldVP (SubViewport 1280×720, 3D, MSAA 4×)  -> Hafen, Dachs, Licht, Environment (Bloom über Glow)
;     WorldView (TextureRect, world_post.gdshader) -> Welt-Looks: Film, LUT, Halbton, Palette
;     UI (Control, ui.gd)                           -> Spieloberfläche, nach den Welt-Looks gezeichnet
;   Final (TextureRect, screen_post.gdshader)      -> Bildschirm-Look CRT (wirkt auch auf die Oberfläche)
;   LabelLayer/LookLabel (label.gd)                -> Beschriftung des Looks, ungefiltert

[ext_resource type="Script" path="res://main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://models/harbor.glb" id="2_harbor"]
[ext_resource type="PackedScene" path="res://models/badger.glb" id="3_badger"]
[ext_resource type="Shader" path="res://shaders/water.gdshader" id="4_water"]
[ext_resource type="Shader" path="res://shaders/beam.gdshader" id="5_beam"]
[ext_resource type="Shader" path="res://shaders/world_post.gdshader" id="6_wpost"]
[ext_resource type="Shader" path="res://shaders/screen_post.gdshader" id="7_spost"]
[ext_resource type="Script" path="res://ui.gd" id="8_ui"]
[ext_resource type="Script" path="res://label.gd" id="9_label"]
[ext_resource type="Texture2D" path="res://textures/lut_kalte_nacht.png" id="10_lut"]
[ext_resource type="Shader" path="res://shaders/sky.gdshader" id="11_sky"]

[sub_resource type="ShaderMaterial" id="SkyMat"]
shader = ExtResource("11_sky")

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMat")

; Grundzustand: dezenter Glow wie in shared/3d; main.gd setzt die Glow-Werte je Look.
[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 3
ambient_light_energy = 0.8
tonemap_mode = 4
glow_enabled = true
glow_intensity = 0.6
glow_hdr_threshold = 1.0
fog_enabled = true
fog_mode = 1
fog_light_color = Color(0.78, 0.56, 0.46, 1)
fog_density = 1.0
fog_sky_affect = 0.0
fog_depth_begin = 30.0
fog_depth_end = 700.0
fog_depth_curve = 1.0
fog_aerial_perspective = 0.4

[sub_resource type="ShaderMaterial" id="WaterMat"]
render_priority = 0
shader = ExtResource("4_water")

[sub_resource type="CylinderMesh" id="BeamMesh"]
top_radius = 3.2
bottom_radius = 0.3
height = 30.0
radial_segments = 24
rings = 1
cap_top = false
cap_bottom = false

[sub_resource type="ShaderMaterial" id="BeamMat"]
render_priority = 0
shader = ExtResource("5_beam")
shader_parameter/color = Color(1, 0.86, 0.6, 1)
shader_parameter/intensity = 0.25
shader_parameter/length_m = 30.0

[sub_resource type="ShaderMaterial" id="WorldPostMat"]
shader = ExtResource("6_wpost")
shader_parameter/lut_tex = ExtResource("10_lut")

[sub_resource type="ShaderMaterial" id="ScreenPostMat"]
shader = ExtResource("7_spost")

[node name="Main" type="Node"]
script = ExtResource("1_main")
water_material = SubResource("WaterMat")

[node name="ScreenVP" type="SubViewport" parent="."]
disable_3d = true
