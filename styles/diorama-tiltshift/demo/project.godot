; Engine configuration file.
; Von Hand geschrieben: Katalogeintrag diorama-tiltshift (Diorama & Miniatur), Godot 4.7.
; Forward+, 1280×720. Der Hafen steht als Modell auf einem Holzsockel; Spielzeugmaterialien
; (Kunststoff, Filz, Holz, Gießharz) kommen aus Shadern, die geringe Schärfentiefe aus der eingebauten
; Bokeh-Tiefenunschärfe (CameraAttributesPractical) mit hoher Qualität und Kreisblende.

config_version=5

[application]

config/name="Diorama & Miniatur – Hafen von Lornholm"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=2
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_bokeh_quality=3
camera/depth_of_field/depth_of_field_use_jitter=false
environment/defaults/default_clear_color=Color(0.12, 0.1, 0.16, 1)
environment/ssao/quality=3
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
textures/default_filters/anisotropic_filtering_level=3

[shader_globals]

dio_time={
"type": "float",
"value": 0.0
}
dio_sun_dir={
"type": "vec3",
"value": Vector3(0.6, 0.55, 0.58)
}
