; Engine configuration file.
; Von Hand geschrieben: Katalogeintrag vertex-animation (Vertex-Animation & gebackene Simulationen), Godot 4.7.

config_version=5

[application]

config/name="Spielgrafik - Vertex-Animation & gebackene Simulationen"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

anti_aliasing/quality/msaa_3d=2
