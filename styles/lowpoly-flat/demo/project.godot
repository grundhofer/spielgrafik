; Engine configuration file.
; Von Hand geschrieben: Katalogeintrag lowpoly-flat (Low-Poly mit Flat-Shading), Godot 4.7.
; Forward+, 1280×720, MSAA 4× (glatte Facettenkanten), Debanding gegen Stufen im Himmelsverlauf.
; Facetten entstehen aus der Low-Poly-Fassung des Hafens (blender/build_lowpoly.py) und aus
; Flächennormalen im Shader (shaders/lowpoly.gdshader).

config_version=5

[application]

config/name="Low-Poly Flat – Hafen von Lornholm"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.18, 0.16, 0.36, 1)
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2

[shader_globals]

lp_time={
"type": "float",
"value": 0.0
}
sky_top={
"type": "color",
"value": Color(0.22, 0.21, 0.5, 1)
}
sky_mid={
"type": "color",
"value": Color(0.5, 0.42, 0.74, 1)
}
sky_low={
"type": "color",
"value": Color(0.93, 0.56, 0.62, 1)
}
sky_glow={
"type": "color",
"value": Color(1, 0.78, 0.56, 1)
}
