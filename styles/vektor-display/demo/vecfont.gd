const UMLAUT := {"Ä": "A", "Ö": "O", "Ü": "U"}


## Züge eines Zeichens in Rasterkoordinaten (y nach oben).
static func strokes(ch: String) -> Array:
	var c := ch.to_upper()
	if c == "ß":
		return []
	if UMLAUT.has(c):
		var s: Array = G[UMLAUT[c]].duplicate()
		s.append([[1, 7.6]])
		s.append([[3, 7.6]])
		return s
	return G.get(c, [])


## Text in Bildschirm-Polylinien: Ursprung = linke Grundlinie, s = Pixel pro Rastereinheit.
## Gibt [ [PackedVector2Array, Zeichenindex], ... ] zurück (für Tippeffekt und Helligkeit je Zeichen).
static func layout(text: String, origin: Vector2, s: float, skew := 0.0) -> Array:
	var out := []
	var x := 0.0
	var idx := 0
	for ch in text.to_upper():
		var glyph := ch
		if ch == "ß":
			glyph = "S"   # Vektorschriften hatten kein ß; als SS gesetzt
			for k in 2:
				for st in strokes(glyph):
					out.append([_stroke(st, origin, x, s, skew), idx])
				x += ADVANCE
			idx += 1
			continue
		for st in strokes(glyph):
			out.append([_stroke(st, origin, x, s, skew), idx])
		x += ADVANCE
		idx += 1
	return out


static func width(text: String, s: float) -> float:
	return (text.length() * ADVANCE - 2.0) * s


static func _stroke(st: Array, origin: Vector2, x: float, s: float, skew: float) -> PackedVector2Array:
	var p := PackedVector2Array()
	for q in st:
		p.append(origin + Vector2((x + q[0] + q[1] * skew) * s, -q[1] * s))
	return p
