; Engine configuration file.
; Von Hand geschrieben: Katalogeintrag einbit-3d (1-Bit-Dithering in 3D), Godot 4.7.
; Die 3D-Szene rendert in 640×360 (stretch mode viewport, ganzzahlig auf 1280×720). Ein Nachbearbeitungs-
; Shader (shaders/onebit_post.gdshader) setzt jedes Pixel auf Papier oder Tinte; eine letzte Ebene
; (ui.gd, Palette) färbt Bild und Oberfläche in genau zwei Farben.

config_version=5

[application]

config/name="1-Bit-3D – Hafen von Lornholm"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_debanding=false
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0

[shader_globals]

onebit_time={
"type": "float",
"value": 0.0
}
