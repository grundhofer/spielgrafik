; Godot 4.7 – Fantasy-Konsole (16 Farben, 128x128), Katalogeintrag pico8-fantasy
config_version=5

[application]

config/name="Fantasy-Konsole (16 Farben, 128x128) – Hafen von Lornholm"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=128
window/size/viewport_height=128
window/size/window_width_override=640
window/size/window_height_override=640
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
