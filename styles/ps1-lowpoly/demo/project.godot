; Engine configuration file.
; Von Hand geschrieben: Katalogeintrag ps1-lowpoly (PS1-Look), Godot 4.7.
; Alles wird in 320×240 gerendert (3D und Oberfläche), capture.py skaliert ganzzahlig ×3.

config_version=5

[application]

config/name="PS1-Look – Hafen von Lornholm"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/window_width_override=960
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[shader_globals]

ps1_snap_res={
"type": "vec2",
"value": Vector2(320, 240)
}
ps1_ambient={
"type": "vec4",
"value": Vector4(0.2, 0.2, 0.3, 1)
}
ps1_sun_dir={
"type": "vec3",
"value": Vector3(0.86, -0.24, -0.46)
}
ps1_sun_color={
"type": "vec4",
"value": Vector4(1, 0.6, 0.35, 1)
}
ps1_light0_pos={
"type": "vec4",
"value": Vector4(0, 0, 0, 1)
}
ps1_light0_color={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
ps1_light1_pos={
"type": "vec4",
"value": Vector4(0, 0, 0, 1)
}
ps1_light1_color={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
ps1_light2_pos={
"type": "vec4",
"value": Vector4(0, 0, 0, 1)
}
ps1_light2_color={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
ps1_fog_color={
"type": "vec4",
"value": Vector4(0.8, 0.4, 0.2, 1)
}
ps1_fog_range={
"type": "vec2",
"value": Vector2(30, 400)
}
ps1_affine={
"type": "float",
"value": 1.0
}
ps1_affine_vc={
"type": "float",
"value": 1.0
}
ps1_ot={
"type": "float",
"value": 1.0
}
ps1_mip={
"type": "float",
"value": 0.0
}
ps1_vc_strength={
"type": "float",
"value": 0.8
}
ps1_time={
"type": "float",
"value": 0.0
}
