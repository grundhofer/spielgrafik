[gd_scene load_steps=11 format=3]

; Vorgerenderte Hintergründe, feste Kamera.
; Die Kamera bekommt je Einstellung exakt die Werte des Blender-Renders (bg/<shot>/meta.json).
; "Background" hängt an der Kamera: Vollbild-Viereck mit Renderbild, Tiefenbild, Bildfolge-Overlay und
; Lichtebene (shaders/bg.gdshader). Davor läuft die echte 3D-Figur (badger_low.glb, Gouraud je Eckpunkt).
; Lichter hier beleuchten nur die Figur; sie sind nach den Lichtern des Renders gesetzt.

[ext_resource type="Script" path="res://main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://models/badger_low.glb" id="2_badger"]
[ext_resource type="Shader" path="res://shaders/bg.gdshader" id="3_bg"]
[ext_resource type="Shader" path="res://shaders/blob.gdshader" id="4_blob"]
[ext_resource type="Script" path="res://ui.gd" id="5_ui"]

[sub_resource type="Environment" id="Env"]
background_mode = 1
background_color = Color(0, 0, 0, 1)
ambient_light_source = 2
ambient_light_color = Color(0.5, 0.48, 0.64, 1)
ambient_light_energy = 0.42
tonemap_mode = 0

[sub_resource type="QuadMesh" id="BgQuad"]
size = Vector2(2, 2)

[sub_resource type="ShaderMaterial" id="BgMat"]
render_priority = 0
shader = ExtResource("3_bg")

[sub_resource type="QuadMesh" id="BlobQuad"]
size = Vector2(1.1, 0.9)
orientation = 1

[sub_resource type="ShaderMaterial" id="BlobMat"]
render_priority = 0
shader = ExtResource("4_blob")

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

[node name="Camera" type="Camera3D" parent="."]
current = true
fov = 52.0
near = 0.05
far = 3000.0

[node name="Background" type="MeshInstance3D" parent="Camera"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -1)
cast_shadow = 0
extra_cull_margin = 16384.0
mesh = SubResource("BgQuad")
surface_material_override/0 = SubResource("BgMat")

[node name="Badger" parent="." instance=ExtResource("2_badger")]

[node name="Blob" type="MeshInstance3D" parent="."]
cast_shadow = 0
mesh = SubResource("BlobQuad")
surface_material_override/0 = SubResource("BlobMat")

; Restlicht der untergegangenen Sonne von hinten rechts (wie DuskSun im Render), Richtung setzt main.gd
[node name="Dusk" type="DirectionalLight3D" parent="."]
light_color = Color(1, 0.6, 0.38, 1)
light_energy = 1.6

; Aufhelllicht aus Kamerarichtung (je Einstellung von main.gd ausgerichtet), damit das Kostüm lesbar bleibt
[node name="Fill" type="DirectionalLight3D" parent="."]
light_color = Color(0.7, 0.72, 0.95, 1)
light_energy = 0.3

; Seitenfenster des Häuschens (an der +X-Giebelwand), an dem der Dachs vorbeiläuft
[node name="WindowSide" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -6.4, 1.5, -0.15)
light_color = Color(1, 0.69, 0.38, 1)
light_energy = 1.3
omni_range = 3.2
omni_attenuation = 1.4

[node name="WindowFront" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -9.2, 1.45, 0.85)
light_color = Color(1, 0.69, 0.38, 1)
light_energy = 1.2
omni_range = 4.5
omni_attenuation = 1.4

[node name="Lantern" type="OmniLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 4.1, 1.79, -0.12)
light_color = Color(1, 0.7, 0.37, 1)
light_energy = 1.6
omni_range = 6.0

[node name="UI" type="CanvasLayer" parent="."]

[node name="Box" type="Control" parent="UI"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("5_ui")
