; Engine configuration file.
; Von Hand geschrieben: Katalogeintrag toon-cel (Cel-Shading mit Konturen), Godot 4.7.
; Forward+, 1280×720. Konturen entstehen als Nachbearbeitung aus Tiefe, Normalen und Material-ID
; (shaders/outline_post.gdshader) und als umgedrehte Hülle um die Figur (shaders/outline_hull.gdshader).

config_version=5

[application]

config/name="Toon-Cel – Hafen von Lornholm"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=2
environment/defaults/default_clear_color=Color(0.1, 0.08, 0.2, 1)
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[shader_globals]

toon_time={
"type": "float",
"value": 0.0
}
toon_rim_dir={
"type": "vec3",
"value": Vector3(0.2, 0.5, -0.84)
}
toon_rim_color={
"type": "color",
"value": Color(1, 0.78, 0.52, 1)
}
sky_top={
"type": "color",
"value": Color(0.1, 0.12, 0.38, 1)
}
sky_mid={
"type": "color",
"value": Color(0.4, 0.27, 0.6, 1)
}
sky_low={
"type": "color",
"value": Color(0.96, 0.52, 0.5, 1)
}
sky_glow={
"type": "color",
"value": Color(1, 0.76, 0.42, 1)
}
