[gd_scene load_steps=16 format=3]

; Katalogeintrag toon-cel: Hafen und Dachs aus shared/3d (unveränderte glb-Kopien), Look nur über
; Materialien, Shader, Licht und Nachbearbeitung. main.gd ersetzt alle glTF-Materialien nach Namen,
; hängt die Knoten unter "Attach" an die Empties des Hafens und animiert alles über die Zeit t.

[ext_resource type="Script" path="res://main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://models/harbor.glb" id="2_harbor"]
[ext_resource type="PackedScene" path="res://models/badger.glb" id="3_badger"]
[ext_resource type="Shader" path="res://shaders/toon_water.gdshader" id="4_water"]
[ext_resource type="Shader" path="res://shaders/toon_beam.gdshader" id="5_beam"]
[ext_resource type="Shader" path="res://shaders/toon_sky.gdshader" id="6_sky"]
[ext_resource type="Script" path="res://ui.gd" id="8_ui"]

[sub_resource type="ShaderMaterial" id="SkyMat"]
shader = ExtResource("6_sky")

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("SkyMat")

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 2
ambient_light_color = Color(0.6, 0.53, 0.76, 1)
ambient_light_energy = 1.0
reflected_light_source = 1
tonemap_mode = 0
glow_enabled = true
glow_intensity = 0.45
glow_strength = 1.0
glow_bloom = 0.0
glow_hdr_threshold = 1.05
glow_blend_mode = 1
fog_enabled = true
fog_mode = 1
fog_light_color = Color(0.78, 0.5, 0.62, 1)
fog_density = 1.0
fog_sky_affect = 0.0
fog_depth_begin = 60.0
fog_depth_end = 900.0
fog_depth_curve = 1.6

[sub_resource type="ShaderMaterial" id="WaterMat"]
render_priority = 0
shader = ExtResource("4_water")

[sub_resource type="CylinderMesh" id="BeamMesh"]
top_radius = 2.6
bottom_radius = 0.25
height = 26.0
radial_segments = 32
rings = 1
cap_top = false
cap_bottom = false

[sub_resource type="ShaderMaterial" id="BeamMat"]
render_priority = 20
shader = ExtResource("5_beam")
shader_parameter/length_m = 26.0

[sub_resource type="QuadMesh" id="ScreenQuad"]
size = Vector2(2, 2)

; Shader setzt main.gd je nach Renderer (Forward+: outline_post, sonst outline_post_depth)
[sub_resource type="ShaderMaterial" id="OutlineMat"]
render_priority = 10

[node name="Main" type="Node3D"]
script = ExtResource("1_main")
water_material = SubResource("WaterMat")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

; Abendsonne tief von links vorn (14° über dem Horizont), Lichtrichtung (0.86, -0.24, -0.46) wie shared/3d
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.4694716, 0.21360436, -0.85672027, 0, 0.9702957, 0.2419219, 0.88294756, -0.113575466, 0.4555263, 0, 30, 0)
light_color = Color(1, 0.74, 0.5, 1)
light_energy = 1.25
shadow_enabled = true
shadow_bias = 0.04
shadow_normal_bias = 1.5
shadow_blur = 0.5
directional_shadow_mode = 1
directional_shadow_max_distance = 60.0
light_cull_mask = 4294967293

; Figurenlicht: eigenes Führungslicht nur für den Dachs (Ebene 2), von links vorn oben, ohne Schatten.
; Hält die Figur in jeder Einstellung lesbar (Licht-, Mittel- und Schattenton sichtbar);
; ihren Schlagschatten wirft der Dachs weiter über die Sonne.
[node name="CharKey" type="DirectionalLight3D" parent="."]
light_color = Color(1, 0.8, 0.6, 1)
light_energy = 1.2
light_cull_mask = 2

; Hauptkamera wie shared/3d: Position (-1.8, 3.4, 14.5), rotation_degrees (-3, 0, 0), fov 42 (vertikal).
; main.gd fährt sie ab CAM_T0 an den Dachs heran.
[node name="Camera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.9986295, 0.05233596, 0, -0.05233596, 0.9986295, -1.8, 3.4, 14.5)
current = true
fov = 42.0
near = 0.1
far = 3000.0

; Konturen: bildschirmfüllendes Rechteck, Position im Shader (POSITION), nie weggeschnitten
[node name="Outline" type="MeshInstance3D" parent="Camera"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -1)
cast_shadow = 0
extra_cull_margin = 16384.0
mesh = SubResource("ScreenQuad")
surface_material_override/0 = SubResource("OutlineMat")

[node name="Harbor" parent="." instance=ExtResource("2_harbor")]

[node name="Badger" parent="." instance=ExtResource("3_badger")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5, 0, 1.2)

[node name="Effects" type="Node3D" parent="."]

[node name="Attach" type="Node3D" parent="."]

[node name="LanternLight" type="Node3D" parent="Attach"]

