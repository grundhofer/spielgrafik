[gd_scene load_steps=16 format=3]

; KI-3D-Modell (lokal): Hafen aus shared/3d, darin Dachs, zwei Fässer, Laterne und ein Boot, die TripoSR
; lokal aus je einem KI-Bild gemacht hat (gesäubert und gebacken in Blender, Dachs auf das Rig aus shared/3d
; übertragen). Oben links ein Drehteller-Fenster mit allen vier Modellen, unten rechts der Dialogkasten.
; main.gd baut die Drehteller, hängt Lichter an die Empties und animiert alles über die aufsummierte Zeit.

[ext_resource type="Script" path="res://main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://models/harbor.glb" id="2_harbor"]
[ext_resource type="PackedScene" path="res://models/badger_tsr.glb" id="3_badger"]
