# Python
.venv/
__pycache__/
*.pyc
.DS_Store

# Godot-Cache je Demo
**/demo/.godot/
**/demo/*.import.bak

# Rohbilder der Bilderzeugung (groß); verarbeitete Fassungen liegen in demo/ und media/.
# Ausnahme: Rohbilder, die ein Steckbrief zeigt (style.json → assets[].file), sind eingecheckt, sonst bricht
# build.py ab. Ihre Begleit-JSON, meta und Logs bleiben draußen (lokale Pfade, Sitzungsdaten). Die Liste ist aus allen
# style.json erzeugt; tests/test_build.py (TestGitignore) scheitert, wenn eine gezeigte Datei ignoriert wird.
styles/*/assets/raw/*
!styles/apple2-hires/assets/raw/bg2_a.png
